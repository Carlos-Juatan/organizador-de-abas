    {
      "parameters": {
        "jsCode": "// Formatar lista de páginas retornadas do MongoDB\nconst items = $input.all();\nconst pages = [];\n\nfor (const item of items) {\n  const p = item.json;\n  if (p && (p.url || p.id)) {\n    const domain = p.domain || (p.url ? (() => {\n      try {\n        const u = new URL(p.url.startsWith('http') ? p.url : 'https://' + p.url);\n        return u.hostname.replace(/^www\\./, '');\n      } catch (e) {\n        return '';\n      }\n    })() : '');\n\n    pages.push({\n      id: String(p.id || p._id),\n      url: String(p.url || ''),\n      title: String(p.title || domain || 'Sem título'),\n      domain: domain,\n      favicon: p.favicon || (domain ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64` : ''),\n      groupId: p.groupId !== undefined ? p.groupId : null,\n      notes: p.notes || '',\n      isFavorite: Boolean(p.isFavorite),\n      createdAt: p.createdAt || new Date().toISOString()\n    });\n  }\n}\n\nreturn [{ json: { pages } }];\n"
      },
      "id": "9ab67563-3050-4427-b666-81628fbc1e25",
      "name": "Code - Format Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
