      ],
      "webhookId": "organizador-post-group"
    },
    {
      "parameters": {
        "jsCode": "// Preparar documento de novo grupo\nconst body = $json.body || $json;\nconst now = new Date().toISOString();\nconst id = 'grp_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n\nconst newGroup = {\n  id: id,\n  name: body.name || 'Novo Grupo',\n  emoji: body.emoji || '📁',\n  color: body.color || '#c86446',\n  createdAt: now\n};\n\nreturn [{ json: newGroup }];\n"
      },
      "id": "a43cd9dd-453f-4112-a088-22b8ffdfcd38",
      "name": "Code - Prepare Group Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        420
      ]
    },
