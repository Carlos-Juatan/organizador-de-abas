    {
      "parameters": {
        "jsCode": "// Formatar grupos retornados do MongoDB para o contrato esperado pelo frontend\nconst items = $input.all();\nconst groups = [];\n\nfor (const item of items) {\n  const g = item.json;\n  if (g && (g.id || g._id)) {\n    groups.push({\n      id: String(g.id || g._id),\n      name: String(g.name || 'Sem nome'),\n      emoji: String(g.emoji || '📁'),\n      color: String(g.color || '#c86446'),\n      createdAt: g.createdAt || new Date().toISOString(),\n      ...(g.updatedAt ? { updatedAt: g.updatedAt } : {})\n    });\n  }\n}\n\nreturn [{ json: { groups } }];\n"
      },
      "id": "6cc1eee8-e834-43f3-bd1b-aa58cc3fdc7a",
      "name": "Code - Format Groups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.groups }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "aec3ec44-6fe8-4e83-8221-5076e113b8e1",
      "name": "Respond - Groups List",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        200
      ]
    },
    {
