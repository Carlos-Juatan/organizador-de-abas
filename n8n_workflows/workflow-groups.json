      "parameters": {
        "jsCode": "// Reatribuir páginas do grupo deletado para Inbox (groupId = null)\nconst items = $input.all();\nif (!items || items.length === 0 || !items[0].json?.id) {\n  return [];\n}\nreturn items.map(item => ({\n  json: {\n    id: item.json.id,\n    groupId: null\n  }\n}));\n"
