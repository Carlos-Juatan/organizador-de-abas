      "id": "98b1317a-4262-4777-ab99-ecf1e6e0d5be",
      "name": "MongoDB - Find Pages",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        480,
        200
      ],
