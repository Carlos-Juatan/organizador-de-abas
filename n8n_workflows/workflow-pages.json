    {
      "parameters": {
        "jsCode": "// Preparar campos atualizados da página (favoritar, mover de grupo, notas, título)\nconst pageId = $json.params?.id;\nconst body = $json.body || {};\n\nconst updateData = {\n  id: pageId\n};\n\nif (body.title !== undefined) updateData.title = body.title;\nif (body.notes !== undefined) updateData.notes = body.notes;\nif (body.groupId !== undefined) updateData.groupId = body.groupId;\nif (body.isFavorite !== undefined) updateData.isFavorite = Boolean(body.isFavorite);\n\nreturn [{ json: updateData }];\n"
      },
