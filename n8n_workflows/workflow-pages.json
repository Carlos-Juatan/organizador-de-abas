          "name": "MongoDB account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Formatar lista de páginas retornadas do MongoDB\nconst items = $input.all();\nconst pages = [];\n\nfor (const item of items) {\n  const p = item.json;\n  if (p && (p.url || p.id)) {\n    const domain = p.domain || (p.url ? (() => {\n      try {\n        const u = new URL(p.url.startsWith('http') ? p.url : 'https://' + p.url);\n        return u.hostname.replace(/^www\\./, '');\n      } catch (e) {\n        return '';\n      }\n    })() : '');\n\n    pages.push({\n      id: String(p.id || p._id),\n      url: String(p.url || ''),\n      title: String(p.title || domain || 'Sem título'),\n      domain: domain,\n      favicon: p.favicon || (domain ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64` : ''),\n      groupId: p.groupId !== undefined ? p.groupId : null,\n      notes: p.notes || '',\n      isFavorite: Boolean(p.isFavorite),\n      createdAt: p.createdAt || new Date().toISOString()\n    });\n  }\n}\n\nreturn [{ json: { pages } }];\n"
      },
      "id": "73aa5e9a-afc7-4bc1-ba1a-97a6c5292ca9",
      "name": "Code - Format Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.pages }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a479c9cf-6c60-4e4c-b4d5-1d5a9dd7b5f6",
      "name": "Respond - Pages List",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pages",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2436057c-1081-4a15-a632-a6603ca935f7",
      "name": "Webhook - POST Pages",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        420
      ],
      "webhookId": "organizador-post-pages"
    },
    {
      "parameters": {
        "jsCode": "// Suporta tanto criação individual quanto criação em lote (bulk import)\nlet raw = $json.body;\nif (!raw && Array.isArray($json)) raw = $json;\nif (!raw && typeof $json === 'object') raw = [$json];\nif (!Array.isArray(raw)) raw = [raw];\n\nfunction extractDomain(urlStr) {\n  try {\n    const u = new URL(urlStr.startsWith('http') ? urlStr : 'https://' + urlStr);\n    return u.hostname.replace(/^www\\./, '');\n  } catch (e) {\n    return urlStr || '';\n  }\n}\n\nconst now = Date.now();\nconst itemsToInsert = raw.filter(item => item && item.url).map((item, idx) => {\n  const domain = extractDomain(item.url);\n  const title = item.title && item.title.trim().length > 0 ? item.title.trim() : domain;\n  const id = 'pg_' + (now + idx).toString(36) + Math.random().toString(36).slice(2, 6);\n  const favicon = item.favicon || `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;\n\n  return {\n    id: id,\n    url: item.url,\n    title: title,\n    domain: domain,\n    favicon: favicon,\n    groupId: item.groupId ?? null,\n    notes: item.notes || '',\n    isFavorite: Boolean(item.isFavorite),\n    createdAt: new Date(now + idx).toISOString()\n  };\n});\n\nreturn itemsToInsert.map(item => ({ json: item }));\n"
      },
      "id": "66869063-59cc-4701-b776-85ad130f0e61",
      "name": "Code - Prepare Pages Insert",
